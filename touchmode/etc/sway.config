# Backpack Touch Mode: tiling only, no decorations, no bar.
set $mod Mod4
set $term foot
font pango:DejaVu Sans 12
default_border none
default_floating_border none
hide_edge_borders both
focus_follows_mouse yes
floating_modifier none
for_window [app_id=".*"] border none, floating disable
for_window [class=".*"] border none, floating disable
# Terminal button: a fullscreen foot over the launcher; `exit` returns to the launcher
for_window [app_id="backpack-term"] fullscreen enable
bar {
    mode invisible
}
output * bg #0f1419 solid_color
input type:touch map_to_output *
input type:tablet_tool map_to_output *
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

bindsym $mod+Return exec sh -c "swaymsg fullscreen disable; exec $term"
bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+k exec pkill -RTMIN -x wvkbd-mobintl
bindsym $mod+Shift+q kill
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+Shift+r reload
bindsym XF86PowerOff exec systemctl poweroff

# On-screen keyboard (wlroots virtual-keyboard protocol: types into any window, foot included).
# Starts hidden; the launcher's Keyboard button / focused text fields show it (SIGUSR2) and hide it (SIGUSR1).
exec wvkbd-mobintl --hidden -L 300 -H 440 --fn "DejaVu Sans 16" --bg 0f1419 --fg 1f2a35 --fg-sp 13303a --press 2ec4b6 --press-sp 2ec4b6 --text e6edf3 --text-sp 8b9bb0
exec backpack-touch
