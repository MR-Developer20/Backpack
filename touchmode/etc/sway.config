# Backpack GUI Mode: tiling only, no decorations, no bar.
set $mod Mod4
set $term foot
font pango:JetBrains Mono 1
default_border none
default_floating_border none
hide_edge_borders both
focus_follows_mouse yes
# Super+left drag moves a floating window, Super+right drag resizes it
floating_modifier $mod normal
# Every window floats, so it never opens inside the focused frame (sway puts a new tiled window next
# to the focused one, even inside a frame); the launcher tiles (matched by its window title: its
# window bars share its app_id). windows.py tiles the Split terminal beside it.
for_window [app_id=".*"] border none, floating enable
for_window [class=".*"] border none, floating enable
for_window [app_id="^backpack-touch$" title="^Backpack Live$"] floating disable
# Terminal button: a fullscreen foot over the launcher; `exit` returns to the launcher
for_window [app_id="backpack-term"] fullscreen enable
# App windows (GUI tools, Extra apps, a tty tool's foot) are framed by the launcher (windows.py):
# maximized and floating, a bar with Close / Maximize / Split on top. The bar's title strip is the
# 5px handle that drags the frame: a 1pt font (3px tall) and 1px padding make sway's titlebar exactly 5px.
titlebar_padding 1 1
titlebar_border_thickness 0
# window edges and the frames' drag strip in the Field Terminal palette: acid when focused,
# grid-strong otherwise (the strip sits on the bar, which is never the focused window for long)
client.focused   #c6ff1a #c6ff1a #c6ff1a #c6ff1a #c6ff1a
client.unfocused #5a6b70 #5a6b70 #5a6b70 #5a6b70 #5a6b70
client.focused_inactive #5a6b70 #5a6b70 #5a6b70 #5a6b70 #5a6b70
bar {
    mode invisible
}
output * bg #07090a solid_color
input type:touch map_to_output *
input type:tablet_tool map_to_output *
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

bindsym $mod+Return exec sh -c "swaymsg fullscreen disable; exec $term"
bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+k exec pkill -RTMIN -x wvkbd-mobintl
bindsym $mod+Shift+q kill
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+Shift+r reload
bindsym XF86PowerOff exec systemctl poweroff

# On-screen keyboard (wlroots virtual-keyboard protocol: types into any window, foot included).
# Starts hidden; the launcher's Keyboard button / focused text fields show it (SIGUSR2) and hide it (SIGUSR1).
exec wvkbd-mobintl --hidden -L 300 -H 440 --fn "JetBrains Mono 16" --bg 07090a --fg 161c1f --fg-sp 0e1214 --press c6ff1a --press-sp c6ff1a --text e6ede8 --text-sp 8d9c96
exec backpack-touch
