# Backpack GUI Mode: tiling only, no decorations, no bar.
set $mod Mod4
set $term foot
font pango:DejaVu Sans 12
default_border none
default_floating_border none
hide_edge_borders both
focus_follows_mouse yes
# Super+left drag moves a floating window, Super+right drag resizes it
floating_modifier $mod normal
for_window [app_id=".*"] border none, floating disable
for_window [class=".*"] border none, floating disable
# Terminal button: a fullscreen foot over the launcher; `exit` returns to the launcher
for_window [app_id="backpack-term"] fullscreen enable
# Extra-tab apps float over the launcher (after the catch-all rules above, so these win), with a
# 6px edge to drag-resize them by; GNOME Web also resizes from its own window edges (GTK CSD).
for_window [class="(?i)ltris"] floating enable, border pixel 6, move position center
for_window [app_id="(?i)ltris"] floating enable, border pixel 6, move position center
for_window [app_id="org.gnome.Epiphany"] floating enable, border pixel 6, resize set width 80 ppt height 80 ppt, move position center
# window edges in the Field Terminal palette: acid when focused, hull otherwise
client.focused   #c6ff1a #c6ff1a #07090a #c6ff1a #c6ff1a
client.unfocused #161c1f #161c1f #8d9c96 #161c1f #161c1f
client.focused_inactive #161c1f #161c1f #8d9c96 #161c1f #161c1f
bar {
    mode invisible
}
output * bg #07090a solid_color
input type:touch map_to_output *
input type:tablet_tool map_to_output *
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

bindsym $mod+Return exec sh -c "swaymsg fullscreen disable; exec $term"
bindsym $mod+h splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+k exec pkill -RTMIN -x wvkbd-mobintl
bindsym $mod+Shift+q kill
bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Right move right
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+e exec swaymsg exit
bindsym $mod+Shift+r reload
bindsym XF86PowerOff exec systemctl poweroff

# On-screen keyboard (wlroots virtual-keyboard protocol: types into any window, foot included).
# Starts hidden; the launcher's Keyboard button / focused text fields show it (SIGUSR2) and hide it (SIGUSR1).
exec wvkbd-mobintl --hidden -L 300 -H 440 --fn "JetBrains Mono 16" --bg 07090a --fg 161c1f --fg-sp 0e1214 --press c6ff1a --press-sp c6ff1a --text e6ede8 --text-sp 8d9c96
exec backpack-touch
