#!/bin/sh
# Writes a report to /var/log/backpack-selftest.log and copies it to ttyS0 (QEMU -serial file:).
LOG=/var/log/backpack-selftest.log
{
echo "BACKPACK-SELFTEST-BEGIN"
echo "CMDLINE: $(cat /proc/cmdline)"
timeout 150 systemctl is-system-running --wait >/dev/null 2>&1
echo "STATE: $(systemctl is-system-running 2>&1)"
echo "BOOTTIME: $(systemd-analyze 2>&1 | head -1)"
systemctl --failed --no-legend --plain 2>/dev/null | sed 's/^/FAILED-UNIT: /'
/usr/local/lib/backpack/check-tools.sh --runtime
if getent passwd user >/dev/null; then echo "LIVE-USER: present ($(id -nG user | tr " " ","))"; else echo "LIVE-USER: absent"; fi
if systemctl is-active --quiet lightdm 2>/dev/null; then
	for _ in $(seq 1 25); do pgrep -f backpack_touch >/dev/null && break; sleep 2; done
	if pgrep -f backpack_touch >/dev/null; then echo "GUI-SESSION: sway + backpack-touch running"; else
		echo "GUI-SESSION: absent"
		echo "--- lightdm effective autologin:"; grep -h '^autologin\|^user-session' /etc/lightdm/lightdm.conf /etc/lightdm/lightdm.conf.d/*.conf 2>&1
		echo "--- loginctl:"; loginctl list-sessions --no-legend 2>&1
		for f in /var/log/lightdm/lightdm.log /var/log/lightdm/seat0-greeter.log /home/user/.xsession-errors /home/user/.local/share/sway/log.txt; do
			[ -f "$f" ] && { echo "--- $f (tail):"; grep -v '^\[+[0-9.]*s\] DEBUG' "$f" | tail -n 25; }
		done
		echo "--- journal lightdm/session:"; journalctl -b --no-pager -o short -u lightdm -q 2>&1 | tail -n 20
		journalctl -b --no-pager -q _COMM=lightdm 2>&1 | grep -i 'session\|pam\|fail\|error' | tail -n 15
	fi
fi
if grep -qw 'backpack.ui=touch' /proc/cmdline; then
	for _ in $(seq 1 30); do pgrep -f backpack_touch >/dev/null && break; sleep 2; done
	echo "TOUCH-SESSION: sway=$(pgrep -x sway >/dev/null && echo running || echo absent) launcher=$(pgrep -f backpack_touch >/dev/null && echo running || echo absent) foot=$(pgrep -x foot >/dev/null && echo running || echo absent)"
	grep -h '' /etc/lightdm/lightdm.conf.d/60-backpack-touch.conf 2>/dev/null | sed 's/^/TOUCH-CONF: /'
	SOCK=$(ls /run/user/1000/sway-ipc.* 2>/dev/null | head -1)
	[ -n "$SOCK" ] && sudo -u user SWAYSOCK="$SOCK" swaymsg -t get_inputs 2>&1 | grep -E '"identifier"|"type"' | paste - - | sed 's/^/SWAY-INPUT: /'
	[ -f /home/user/.xsession-errors ] && grep -iE 'error|warn|fail|input|seat|xkb' /home/user/.xsession-errors | tail -n 15 | sed 's/^/SWAY-LOG: /'
	if ! pgrep -f backpack_touch >/dev/null; then
		journalctl -b --no-pager -q -u lightdm 2>&1 | tail -n 8
		for f in /home/user/.local/share/sway/log.txt /var/log/lightdm/seat0-greeter.log /home/user/.xsession-errors; do [ -f "$f" ] && { echo "--- $f:"; tail -n 20 "$f"; }; done
		journalctl -b --no-pager -q _UID=1000 2>&1 | grep -iv 'debug' | tail -n 25
	fi
fi
echo "HOME-MOUNT: $(findmnt -n -o SOURCE,FSTYPE /home 2>&1)"
if [ -f /home/user/.persist-marker ]; then
	echo PERSIST-MARKER-FOUND
else
	touch /home/user/.persist-marker && chown user:user /home/user/.persist-marker
	echo PERSIST-MARKER-CREATED
fi
sync
echo BACKPACK-SELFTEST-DONE
} > "$LOG" 2>&1
[ -c /dev/ttyS0 ] && cat "$LOG" > /dev/ttyS0
grep -qw backpack.poweroff /proc/cmdline && { sleep 2; systemctl poweroff; }
exit 0
