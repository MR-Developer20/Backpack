#!/bin/sh
# Writes a report to /var/log/nettoolkit-selftest.log and copies it to ttyS0 (QEMU -serial file:).
LOG=/var/log/nettoolkit-selftest.log
{
echo "NETTOOLKIT-SELFTEST-BEGIN"
echo "CMDLINE: $(cat /proc/cmdline)"
timeout 150 systemctl is-system-running --wait >/dev/null 2>&1
echo "STATE: $(systemctl is-system-running 2>&1)"
echo "BOOTTIME: $(systemd-analyze 2>&1 | head -1)"
systemctl --failed --no-legend --plain 2>/dev/null | sed 's/^/FAILED-UNIT: /'
/usr/local/lib/nettoolkit/check-tools.sh
if getent passwd user >/dev/null; then echo "LIVE-USER: present ($(id -nG user | tr " " ","))"; else echo "LIVE-USER: absent"; fi
if systemctl is-active --quiet lightdm 2>/dev/null; then
	for _ in $(seq 1 25); do pgrep -x lxqt-session >/dev/null && break; sleep 2; done
	if pgrep -x lxqt-session >/dev/null; then echo "DESKTOP-SESSION: lxqt-session running"; else
		echo "DESKTOP-SESSION: absent"
		echo "--- lightdm effective autologin:"; grep -h '^autologin\|^user-session' /etc/lightdm/lightdm.conf /etc/lightdm/lightdm.conf.d/*.conf 2>&1
		echo "--- loginctl:"; loginctl list-sessions --no-legend 2>&1
		for f in /var/log/lightdm/lightdm.log /var/log/lightdm/seat0-greeter.log /var/log/lightdm/x-0.log /home/user/.xsession-errors /home/user/.cache/lxqt-session.log; do
			[ -f "$f" ] && { echo "--- $f (tail):"; grep -v '^\[+[0-9.]*s\] DEBUG' "$f" | tail -n 25; }
		done
		echo "--- journal lightdm/session:"; journalctl -b --no-pager -o short -u lightdm -q 2>&1 | tail -n 20
		journalctl -b --no-pager -q _COMM=lightdm 2>&1 | grep -i 'session\|pam\|fail\|error' | tail -n 15
	fi
fi
echo "HOME-MOUNT: $(findmnt -n -o SOURCE,FSTYPE /home 2>&1)"
if [ -f /home/user/.persist-marker ]; then
	echo PERSIST-MARKER-FOUND
else
	touch /home/user/.persist-marker && chown user:user /home/user/.persist-marker
	echo PERSIST-MARKER-CREATED
fi
sync
echo NETTOOLKIT-SELFTEST-DONE
} > "$LOG" 2>&1
[ -c /dev/ttyS0 ] && cat "$LOG" > /dev/ttyS0
grep -qw nettoolkit.poweroff /proc/cmdline && { sleep 2; systemctl poweroff; }
exit 0
