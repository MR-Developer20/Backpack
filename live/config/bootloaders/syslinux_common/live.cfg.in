label live-@FLAVOUR@-gui
	menu label ^GUI Mode
	menu default
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ backpack.ui=touch

label live-@FLAVOUR@-cli
	menu label ^CLI Mode
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ systemd.unit=multi-user.target

label live-@FLAVOUR@-gui-toram
	menu label GUI Mode - copy to ^RAM
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ backpack.ui=touch toram

label live-@FLAVOUR@-cli-toram
	menu label CLI Mode - copy to RAM
	linux @LINUX@
	initrd @INITRD@
	append @APPEND_LIVE@ systemd.unit=multi-user.target toram
